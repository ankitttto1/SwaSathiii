# Supabase (required for app)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# OpenAI — EcoSaathi floating chat (optional; leave empty to show setup hint in chat UI)
VITE_OPENAI_API_KEY=

# Optional: full URL to chat completions (same-origin in production to avoid CORS), e.g. https://yourdomain.com/api/v1/chat/completions
# Dev: leave unset to use Vite proxy /openai-v1 → api.openai.com
VITE_OPENAI_API_URL=
